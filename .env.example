# 复制为 .env 后填写。不要提交真实密码或密钥。
APP_PORT=3000
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://infinite_canvas:replace-with-a-strong-password@db:5432/infinite_canvas
SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
REGISTRATION_OPEN=true
QUOTA_TIMEZONE=Asia/Tokyo

# S3 兼容对象存储。本地配合 docker-compose.local.yml 使用 MinIO；生产换成独立 S3 / R2。
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=infinite-canvas
S3_ACCESS_KEY_ID=infinite_canvas
S3_SECRET_ACCESS_KEY=infinite_canvas
S3_FORCE_PATH_STYLE=true

# 可选：首次 seed 时自动创建 Azure OpenAI 渠道与模型。
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=preview

# 可选统计。
ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=

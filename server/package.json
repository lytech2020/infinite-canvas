{
    "name": "@basketikun/infinite-canvas-server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/src/index.js",
        "typecheck": "tsc --noEmit",
        "migrate": "prisma migrate deploy",
        "migrate:dev": "prisma migrate dev",
        "seed": "tsx prisma/seed.ts"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1104.0",
        "@aws-sdk/s3-request-presigner": "^3.1104.0",
        "@prisma/client": "^6.3.0",
        "argon2": "^0.41.1",
        "cookie-parser": "^1.4.7",
        "dayjs": "^1.11.21",
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "express-rate-limit": "^8.6.2",
        "js-tiktoken": "^1.0.21",
        "music-metadata": "^11.14.0",
        "sharp": "^0.35.3",
        "winston": "^3.19.0",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.8",
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "prisma": "^6.3.0",
        "tsx": "^4.19.0",
        "typescript": "^5.8.0"
    },
    "engines": {
        "node": ">=20"
    }
}

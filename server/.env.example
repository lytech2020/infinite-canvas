# 服务
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# 数据库
DATABASE_URL=postgresql://infinite_canvas:infinite_canvas@127.0.0.1:5432/infinite_canvas

# 渠道 API Key 的加密主密钥，32 字节 base64：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=

# 会话
SESSION_COOKIE_NAME=ic_session
SESSION_TTL_DAYS=30

# 初始管理员，由 prisma seed 创建，创建后请立即修改密码
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# 是否开放自助注册，仅作为首次写入 app_settings 的初始值
REGISTRATION_OPEN=true

# 初始 AI 渠道（可选）。三项都填时，prisma db seed 会创建一个 Azure OpenAI 渠道和一个文本模型，
# API Key 会加密后写入数据库，之后即可在管理接口维护，不再依赖这里的值。
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# 多个部署用逗号分隔，可用 部署名:能力 指定能力（text / image / video / audio），省略能力时按 text 处理
# 例：AZURE_OPENAI_DEPLOYMENT=gpt-4o:text,gpt-image-1:image,sora:video
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=preview

# 并发保护与供应商超时
USER_MAX_CONCURRENT_JOBS=2
USER_MAX_CONCURRENT_VIDEO_JOBS=1
# 每日和每月账户限额的重置时区
QUOTA_TIMEZONE=Asia/Tokyo
PROVIDER_TIMEOUT_MS=120000
PROVIDER_VIDEO_TIMEOUT_MS=900000

# 对象存储（S3 兼容）。本地开发用 MinIO，生产可换 S3 / R2 等。
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=infinite-canvas
S3_ACCESS_KEY_ID=infinite_canvas
S3_SECRET_ACCESS_KEY=infinite_canvas
# MinIO 需要开启路径风格访问
S3_FORCE_PATH_STYLE=true
# 上传地址有效期（秒）
UPLOAD_URL_TTL_SECONDS=300
# 结果下载地址有效期（秒）
DOWNLOAD_URL_TTL_SECONDS=3600
# 未被任务使用的临时上传文件保留小时数
TEMP_FILE_TTL_HOURS=24
